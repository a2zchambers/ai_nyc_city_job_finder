from urllib.parse import (
    urlparse,
    parse_qs,
    urlencode,
    urlunparse
)


def build_paged_url(base_url, page_num):
    parsed = urlparse(base_url)

    query_params = parse_qs(parsed.query)

    query_params["page"] = [str(page_num)]

    new_query = urlencode(
        query_params,
        doseq=True
    )

    return urlunparse(
        (
            parsed.scheme,
            parsed.netloc,
            parsed.path,
            parsed.params,
            new_query,
            parsed.fragment
        )
    )
